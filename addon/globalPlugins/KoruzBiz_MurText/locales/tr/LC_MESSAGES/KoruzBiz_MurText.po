# Genel

msgid "An error occurred while identifying the application."
msgstr "Uygulama belirlenirken bir hata oluştu."

# Mesajlar

msgid "An error occurred."
msgstr "Bir hata oluştu."

msgid "Ask me every time"
msgstr "Her seferinde tercihimi sor"

msgid "Copy"
msgstr "Kopyala"

# WhatsApp

msgid "Copy or Download was not found in the menu. The file may not be downloaded yet, or the download may still be in progress; try again in a few seconds. If the problem persists, check the Copy and Download labels in the settings."
msgstr "Menüde Kopyala veya İndir bulunamadı. Dosya henüz indirilmemiş ya da indirme sürüyor olabilir; birkaç saniye sonra yeniden deneyin. Sorun sürerse ayarlardaki Kopyala ve İndir etiketlerini kontrol edin."

msgid "Could not click the Copy option. Please open the Settings dialog and save the Copy label you see in WhatsApp’s context menu."
msgstr "Kopyala seçeneğine tıklanamadı. Lütfen ayarlar iletişim kutusundan kopyala etiketini tanımlayın."

msgid "Default file save location"
msgstr "Varsayılan dosya kayıt yeri"

msgid "Define the Copy label in WhatsApp Desktop."
msgstr "WhatsApp Desktop Kopyala etiketi tanımlayın"

# Hata mesajları 

msgid "Define the Download label in WhatsApp Desktop."
msgstr "WhatsApp Masaüstü'ndeki İndir etiketini tanımlayın."

msgid "Enter the context-menu \"Copy\" text as shown in WhatsApp Desktop (e.g. \"Copy\", \"Kopyala\", \"複製\")."
msgstr "Bağlam menüsündeki \"Kopyala\" metnini WhatsApp Masaüstü'nde göründüğü gibi girin (örn. \"Copy\", \"Kopyala\", \"複製\")."

msgid "Enter the context-menu \"Download\" text as shown in WhatsApp Desktop (e.g. \"Download\", \"İndir\", \"下載\"). Use \";\" to separate multiple equivalents."
msgstr "Bağlam menüsündeki \"İndir\" metnini WhatsApp Masaüstü'nde göründüğü gibi girin (örn. \"Download\", \"İndir\", \"下載\"). Birden fazla karşılık için \";\" kullanın."

msgid "Failed to open the menu."
msgstr "Menü açma işlemi başarısız."

msgid "Failed to retrieve file from clipboard."
msgstr "Panodan dosya alınamadı."

msgid "Invalid procedure or file path."
msgstr "Geçersiz yordam veya dosya yolu."

msgid "Koruz.biz MurText"
msgstr "Körüz.biz MurText"

msgid "MurText"
msgstr "MurText"

msgid "MurText - Select task type"
msgstr "MurText - Görev tipi seçin"

msgid "MurText is waiting for the download to finish."
msgstr "MurText, indirme işleminin bitmesini bekliyor."

msgid "MurText not found"
msgstr "MurText bulunamadı"

msgid "Opening with MurText. Preparing the application."
msgstr "MurText ile açılıyor. Uygulama hazırlanıyor."

msgid "Please switch modes first with NVDA+SPACE."
msgstr "Lütfen önce NVDA+SPACE ile kip değiştirin."

msgid "Remember my choice"
msgstr "Seçimimi hatırla"

msgid "Save audio / video files to the folder"
msgstr "Ses / video dosyalarını dizine kaydet"

msgid "Save the file"
msgstr "Dosyayı kaydet"

msgid "Select folder"
msgstr "Dizin seç"

msgid "Select the save folder"
msgstr "Kayıt klasörünü seçin"

msgid "Send audio / video files to MurText"
msgstr "Ses / video dosyalarını MurText'e gönder"

msgid "Send the file to MurText"
msgstr "Dosyayı MurText'e gönder"

msgid "Specify the task type"
msgstr "Görev tipini belirleyin"

msgid "The downloaded file was not found. Check the browser's download location."
msgstr "İndirilen dosya bulunamadı. Tarayıcının indirme konumunu kontrol edin."

msgid "The file could not be saved."
msgstr "Dosya kaydedilemedi."

msgid "The file has not been downloaded yet or the Copy option is unavailable. Please open the Settings dialog and save the Copy label you see in WhatsApp’s context menu."
msgstr "Dosya henüz bilgisayara indirilmemiş veya kopyala seçeneği yok. Lütfen ayarlar iletişim kutusundan kopyala etiketini tanımlayın."

msgid "The file is downloading. Please try again in a few seconds."
msgstr "Dosya indiriliyor. Lütfen birkaç saniye sonra yeniden deneyin."

msgid "The file was saved with MurText."
msgstr "Dosya MurText ile kaydedildi."

msgid "The message's menu button was not found. Move focus to the first line of the message and try again."
msgstr "Mesajın menü düğmesi bulunamadı. Odağı mesajın ilk satırına getirip yeniden deneyin."

msgid "The MurText add-on is not configured for this application."
msgstr "MurText eklentisi bu uygulama için yapılandırılmamış."

msgid "The selected item is not supported by MurText."
msgstr "Seçilen öğe MurText tarafından desteklenmiyor."

msgid "What would you like to do?"
msgstr "Ne yapmak istiyorsunuz?"

msgid "You cannot proceed without MurText, a free application. Would you like to download it?"
msgstr "Ücretsiz bir uygulama olan MurText olmadan devam edemezsiniz. İndirmek ister misiniz?"
