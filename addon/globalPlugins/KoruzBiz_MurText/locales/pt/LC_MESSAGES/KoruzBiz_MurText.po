"Language: pt_BR\n"

# Geral

msgid "An error occurred while identifying the application."
msgstr "Ocorreu um erro ao identificar o aplicativo."

# Mensagens

msgid "An error occurred."
msgstr "Ocorreu um erro."

msgid "Ask me every time"
msgstr "Perguntar sempre"

msgid "Copy"
msgstr "Copiar"

# WhatsApp

msgid "Copy or Download was not found in the menu. The file may not be downloaded yet, or the download may still be in progress; try again in a few seconds. If the problem persists, check the Copy and Download labels in the settings."
msgstr "Nem Copiar nem Transferir foram encontrados no menu. O ficheiro pode ainda não ter sido transferido, ou a transferência ainda pode estar em curso; tente novamente dentro de alguns segundos. Se o problema persistir, verifique os rótulos Copiar e Transferir nas definições."

msgid "Could not click the Copy option. Please open the Settings dialog and save the Copy label you see in WhatsApp’s context menu."
msgstr "Não foi possível clicar na opção Copiar. Abra a janela de configurações e salve o rótulo Copiar que você vê no menu de contexto do WhatsApp."

msgid "Default file save location"
msgstr "Local padrão para salvar arquivos"

msgid "Define the Copy label in WhatsApp Desktop."
msgstr "Defina o rótulo Copiar no WhatsApp Desktop."

# Mensagens de erro

msgid "Define the Download label in WhatsApp Desktop."
msgstr "Defina o rótulo Transferir no WhatsApp Desktop."

msgid "Enter the context-menu \"Copy\" text as shown in WhatsApp Desktop (e.g. \"Copy\", \"Kopyala\", \"複製\")."
msgstr "Introduza o texto «Copiar» do menu de contexto tal como aparece no WhatsApp Desktop (e.g. \"Copy\", \"Kopyala\", \"複製\")."

msgid "Enter the context-menu \"Download\" text as shown in WhatsApp Desktop (e.g. \"Download\", \"İndir\", \"下載\"). Use \";\" to separate multiple equivalents."
msgstr "Introduza o texto «Transferir» do menu de contexto tal como aparece no WhatsApp Desktop (e.g. \"Download\", \"İndir\", \"下載\"). Use «;» para separar vários equivalentes."

msgid "Failed to open the menu."
msgstr "Falha ao abrir o menu."

msgid "Failed to retrieve file from clipboard."
msgstr "Falha ao obter o arquivo da área de transferência."

msgid "Invalid procedure or file path."
msgstr "Procedimento ou caminho de arquivo inválido."

msgid "Koruz.biz MurText"
msgstr "Koruz.biz MurText"

msgid "MurText"
msgstr "MurText"

msgid "MurText - Select task type"
msgstr "MurText - Selecione o tipo de tarefa"

msgid "MurText is waiting for the download to finish."
msgstr "O MurText está aguardando a conclusão do download."

msgid "MurText not found"
msgstr "MurText não encontrado"

msgid "Opening with MurText. Preparing the application."
msgstr "Abrindo com MurText. Preparando o aplicativo."

msgid "Please switch modes first with NVDA+SPACE."
msgstr "Mude primeiro de modo com NVDA+SPACE."

msgid "Remember my choice"
msgstr "Lembrar a minha escolha"

msgid "Save audio / video files to the folder"
msgstr "Guardar os ficheiros de áudio / vídeo na pasta"

msgid "Save the file"
msgstr "Guardar o ficheiro"

msgid "Select folder"
msgstr "Selecionar pasta"

msgid "Select the save folder"
msgstr "Selecionar pasta de salvamento"

msgid "Send audio / video files to MurText"
msgstr "Enviar os ficheiros de áudio / vídeo para o MurText"

msgid "Send the file to MurText"
msgstr "Enviar o ficheiro para o MurText"

msgid "Specify the task type"
msgstr "Especifique o tipo de tarefa"

msgid "The downloaded file was not found. Check the browser's download location."
msgstr "O arquivo baixado não foi encontrado. Verifique o local de download do navegador."

msgid "The file could not be saved."
msgstr "Não foi possível salvar o arquivo."

msgid "The file has not been downloaded yet or the Copy option is unavailable. Please open the Settings dialog and save the Copy label you see in WhatsApp’s context menu."
msgstr "O arquivo ainda não foi baixado ou a opção Copiar não está disponível. Abra a janela de configurações e salve o rótulo Copiar que você vê no menu de contexto do WhatsApp."

msgid "The file is downloading. Please try again in a few seconds."
msgstr "O ficheiro está a ser transferido. Tente novamente dentro de alguns segundos."

msgid "The file was saved with MurText."
msgstr "O arquivo foi salvo com MurText."

msgid "The message's menu button was not found. Move focus to the first line of the message and try again."
msgstr "O botão de menu da mensagem não foi encontrado. Coloque o foco na primeira linha da mensagem e tente novamente."

msgid "The MurText add-on is not configured for this application."
msgstr "O complemento MurText não está configurado para este aplicativo."

msgid "The selected item is not supported by MurText."
msgstr "O item selecionado não é compatível com MurText."

msgid "What would you like to do?"
msgstr "O que pretende fazer?"

msgid "You cannot proceed without MurText, a free application. Would you like to download it?"
msgstr "Você não pode continuar sem o MurText, um aplicativo gratuito. Deseja baixá-lo?"
