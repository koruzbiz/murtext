# Generale

msgid "An error occurred while identifying the application."
msgstr "Si è verificato un errore durante l'identificazione dell'applicazione."

# Messaggi

msgid "An error occurred."
msgstr "Si è verificato un errore."

msgid "Ask me every time"
msgstr "Chiedimelo ogni volta"

msgid "Copy"
msgstr "Copia"

# WhatsApp

msgid "Copy or Download was not found in the menu. The file may not be downloaded yet, or the download may still be in progress; try again in a few seconds. If the problem persists, check the Copy and Download labels in the settings."
msgstr "Né Copia né Scarica sono stati trovati nel menu. Il file potrebbe non essere ancora stato scaricato, oppure il download potrebbe essere ancora in corso; riprova tra qualche secondo. Se il problema persiste, controlla le etichette Copia e Scarica nelle impostazioni."

msgid "Could not click the Copy option. Please open the Settings dialog and save the Copy label you see in WhatsApp’s context menu."
msgstr "Impossibile fare clic sull’opzione Copia. Apri la finestra delle impostazioni e salva l’etichetta Copia che vedi nel menu contestuale di WhatsApp."

msgid "Default file save location"
msgstr "Percorso predefinito per il salvataggio dei file"

msgid "Define the Copy label in WhatsApp Desktop."
msgstr "Definisci l’etichetta Copia in WhatsApp Desktop."

# Messaggi di errore

msgid "Define the Download label in WhatsApp Desktop."
msgstr "Definisci l'etichetta Scarica in WhatsApp Desktop."

msgid "Enter the context-menu \"Copy\" text as shown in WhatsApp Desktop (e.g. \"Copy\", \"Kopyala\", \"複製\")."
msgstr "Inserisci il testo «Copia» del menu contestuale così come appare in WhatsApp Desktop (e.g. \"Copy\", \"Kopyala\", \"複製\")."

msgid "Enter the context-menu \"Download\" text as shown in WhatsApp Desktop (e.g. \"Download\", \"İndir\", \"下載\"). Use \";\" to separate multiple equivalents."
msgstr "Inserisci il testo «Scarica» del menu contestuale così come appare in WhatsApp Desktop (e.g. \"Download\", \"İndir\", \"下載\"). Usa «;» per separare più equivalenti."

msgid "Failed to open the menu."
msgstr "Impossibile aprire il menu."

msgid "Failed to retrieve file from clipboard."
msgstr "Impossibile recuperare il file dagli appunti."

msgid "Invalid procedure or file path."
msgstr "Procedura o percorso del file non valido."

msgid "Koruz.biz MurText"
msgstr "Koruz.biz MurText"

msgid "MurText"
msgstr "MurText"

msgid "MurText - Select task type"
msgstr "MurText - Seleziona il tipo di attività"

msgid "MurText is waiting for the download to finish."
msgstr "MurText sta aspettando il completamento del download."

msgid "MurText not found"
msgstr "MurText non trovato"

msgid "Opening with MurText. Preparing the application."
msgstr "Apertura con MurText. Preparazione dell'applicazione."

msgid "Please switch modes first with NVDA+SPACE."
msgstr "Cambia prima la modalità con NVDA+SPACE."

msgid "Remember my choice"
msgstr "Ricorda la mia scelta"

msgid "Save audio / video files to the folder"
msgstr "Salva i file audio / video nella cartella"

msgid "Save the file"
msgstr "Salva il file"

msgid "Select folder"
msgstr "Seleziona cartella"

msgid "Select the save folder"
msgstr "Seleziona la cartella di salvataggio"

msgid "Send audio / video files to MurText"
msgstr "Invia i file audio / video a MurText"

msgid "Send the file to MurText"
msgstr "Invia il file a MurText"

msgid "Specify the task type"
msgstr "Specifica il tipo di attività"

msgid "The downloaded file was not found. Check the browser's download location."
msgstr "Il file scaricato non è stato trovato. Controlla la cartella di download del browser."

msgid "The file could not be saved."
msgstr "Impossibile salvare il file."

msgid "The file has not been downloaded yet or the Copy option is unavailable. Please open the Settings dialog and save the Copy label you see in WhatsApp’s context menu."
msgstr "Il file non è stato ancora scaricato oppure l’opzione Copia non è disponibile. Apri la finestra delle impostazioni e salva l’etichetta Copia che vedi nel menu contestuale di WhatsApp."

msgid "The file is downloading. Please try again in a few seconds."
msgstr "Il file è in fase di download. Riprova tra qualche secondo."

msgid "The file was saved with MurText."
msgstr "Il file è stato salvato con MurText."

msgid "The message's menu button was not found. Move focus to the first line of the message and try again."
msgstr "Il pulsante del menu del messaggio non è stato trovato. Sposta il focus sulla prima riga del messaggio e riprova."

msgid "The MurText add-on is not configured for this application."
msgstr "Il componente aggiuntivo MurText non è configurato per questa applicazione."

msgid "The selected item is not supported by MurText."
msgstr "L'elemento selezionato non è supportato da MurText."

msgid "What would you like to do?"
msgstr "Cosa vuoi fare?"

msgid "You cannot proceed without MurText, a free application. Would you like to download it?"
msgstr "Non puoi procedere senza MurText, un'applicazione gratuita. Vuoi scaricarla?"
